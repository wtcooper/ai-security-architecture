# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

temp/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp screenshots
.playwright-mcp

# static export
/out

# generated by `npm run data` (which dev, build and test run first); never committed
/src/data/generated/dataset.json
/src/data/generated/feed.json
/src/data/generated/security-tools.json
/public/data/feed/

# agent worktrees
.claude/worktrees/
